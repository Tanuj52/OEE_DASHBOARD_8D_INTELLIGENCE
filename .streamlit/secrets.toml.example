# Copy to .streamlit/secrets.toml (git-ignored) for a local run of the hosted mode, or paste into
# Streamlit Community Cloud > App settings > Secrets. With this block present the app connects with
# these credentials, binds to the database below and locks the connection settings.
#
# Key pair (recommended; a hosted app cannot answer an MFA prompt):
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
#   openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
#   ALTER USER <user> SET RSA_PUBLIC_KEY='<rsa_key.pub without the BEGIN/END lines>';

[snowflake]
account = "<orgname-accountname>"
user = "<user>"
role = "<role>"
warehouse = "COMPUTE_WH"
database = "MANUFACTURING_8D"
private_key = """-----BEGIN PRIVATE KEY-----
<contents of rsa_key.p8>
-----END PRIVATE KEY-----"""
# private_key_passphrase = "<only if the key is encrypted>"
# password = "<instead of private_key>"
# app_user = "Plant user"   # name shown in audit trails for anonymous visitors
